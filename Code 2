# PATTERN 2: FACTORY (ask by name, get the matching object)
# --------------------------------------------
class FrenchLocalizer:
def __init__(self):
self.words = {"car": "voiture", "bike": "bicyclette"}
def localize(self, msg):
return self.words.get(msg, msg) # fallback: unknown words pass through
unchanged
class SpanishLocalizer:
def __init__(self):
self.words = {"car": "coche", "bike": "bicicleta"}
def localize(self, msg):
return self.words.get(msg, msg) class EnglishLocalizer:
def localize(self, msg):
return msg # no translation needed, pass it straight through
def language_factory(language="English"): # THE factory - a single entry point for all
objects
localizers = {
"French": FrenchLocalizer,
"Spanish": SpanishLocalizer,
"English": EnglishLocalizer,
}
return localizers[language]() # note the () - this is what actually builds the object
print("\n---- 2. FACTORY ----")
f = language_factory("French")
s = language_factory("Spanish")
print("car in French :", f.localize("car"))
print("car in Spanish:", s.localize("car"))
