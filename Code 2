# PATTERN 3: OBSERVER (one publishes, everyone gets notified)
# --------------------------------------------
class Blog: # the SUBJECT being watched (think: a YouTube channel)
def __init__(self, name):
self.name = name
self._subscribers = [] # holds every registered observer
def subscribe(self, subscriber):
self._subscribers.append(subscriber)
print(subscriber.email, "subscribed to", self.name)
def publish(self, title): # one publish event...
print(self.name, "published:", title)
for sub in self._subscribers: # ...triggers a notification for every subscriber
sub.notify(self.name, title)
class Reader: # the OBSERVER (think: a subscriber)
def __init__(self, email):
self.email = email
def notify(self, blog_name, title): # invoked by the Blog, never called directly
print(" Email to", self.email, ": new post -", title) print("\n---- 3. OBSERVER ----")
blog = Blog("DevDaily")
blog.subscribe(Reader("anna@mail.com"))
blog.subscribe(Reader("raj@mail.com"))
blog.publish("10 Python Tips")
