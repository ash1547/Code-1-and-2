# PATTERN 4: STRATEGY (swap the algorithm at runtime)
# --------------------------------------------
from abc import ABC, abstractmethod
class PaymentStrategy(ABC): # the shared CONTRACT every strategy must
follow
@abstractmethod
def pay(self, amount):
pass
class UPI(PaymentStrategy):
def pay(self, amount):
return f"Paid Rs.{amount} via UPI"
class Card(PaymentStrategy):
def pay(self, amount):
return f"Paid Rs.{amount} via Card"
class Checkout: # the CONTEXT - delegates to a strategy, doesn't care
which
def __init__(self, strategy: PaymentStrategy):
self.strategy = strategy # store whichever strategy we're handed
def set_strategy(self, strategy): # swap the algorithm at runtime, no other code
changes
self.strategy = strategy
def pay(self, amount):
return self.strategy.pay(amount) # hand off the real work to the current strategy
print("\n---- 4. STRATEGY ----")
cart = Checkout(UPI())
print(cart.pay(500)) c
