# PATTERN 1: SINGLETON (only one instance ever exists)
# --------------------------------------------
class WiFiRouter:
_instance = None # class attribute, shared by every instance
def __new__(cls): # __new__ runs before __init__; it CREATES the object
if cls._instance is None: # no instance yet? this is the first call
cls._instance = super().__new__(cls) # create the one-and-only instance and cache
it
cls._instance.connected_devices = [] # set up its device list (only happens once)
return cls._instance # always hand back that same cached instance
def connect(self, device):
self.connected_devices.append(device)
print("---- 1. SINGLETON ----")
papa_phone = WiFiRouter()
my_laptop = WiFiRouter()
papa_phone.connect("Papa's Phone")
my_laptop.connect("My Laptop")
print("Same router?", papa_phone is my_laptop)
print("Devices:", my_laptop.connected_devices)
